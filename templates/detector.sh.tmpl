#!/usr/bin/env bash
# <what this detects, in one line> — a detector of AGENT <N> (contract-session § 6).
# Enforces: <id>, <id>
# Reads: <the artifact it reads — a table, a folder, a log; never a report of it>
#
# The class of a domain's detector, as the method fixes it: it lives under
# .critos/checks/a<N>/ (one writer, rooted by construction); its first lines name the rule(s)
# it enforces, so that a tier-2 claim resolves to it; and it answers one CLI contract:
#   --check     the default. exit 0 clean · 1 with findings · 2 when it cannot answer (no data,
#               a missing input — never a silent zero: a green that cannot go red is not evidence)
#   --selftest  fires the detector on a known positive of its own and fails unless it goes red
# One line per finding, in the battery's form: TOKEN  <where>  <what> — it detects, never repairs.
# It imports nothing from another agent's folder. A command in another repository of the project
# names that repository as .claude/repos declares it, never by a machine path.
# A project writes this in its own language keeping the contract; the shape is the method's, the
# language and the vocabulary are the project's.
set -uo pipefail
mode="${1:---check}"

detect() {   # print one line per finding; return 0 clean, 1 findings, 2 cannot answer
  local input="$1" any=0
  [ -e "$input" ] || { echo "SKIPPED  <token> — $input is missing: cannot answer (NOT a clean none)"; return 2; }
  # <read the artifact; for each violation:>
  #   echo "<TOKEN>  <where>  <what, and what to do>"; any=1
  [ "$any" = 1 ] && return 1
  return 0
}

case "$mode" in
  --check)
    detect "<the artifact>" ;;
  --selftest)
    # a known positive, built here, that MUST make detect() go red
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    # <plant the violation under $tmp>
    if detect "$tmp/<the artifact>" >/dev/null; then echo "FAIL  selftest — the known positive did not fire"; exit 1; fi
    echo "ok    selftest — the known positive fired"; exit 0 ;;
  *) echo "usage: $0 [--check | --selftest]" >&2; exit 2 ;;
esac
